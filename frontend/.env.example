# Base URL the frontend uses to reach the backend API.
#
# Leave this unset during development. The app then calls the relative /api
# prefix, and Vite's dev server proxies those requests to http://localhost:4000
# (see vite.config.ts). Talking to a single origin this way means the backend
# needs no CORS entry for the dev server.
#
# Set it for a production build so requests go straight to the deployed API
# origin instead of through the proxy:
# VITE_API_URL=https://api.layap.app
