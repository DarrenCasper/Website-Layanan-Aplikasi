# Port to use for development purpose
PORT=4000
# node env, depends on development or production later
NODE_ENV=development
# SQL root password
MYSQL_ROOT_PASSWORD=key123
# SQL DB name
MYSQL_DATABASE=my_db
#SQL user
MYSQL_USER=my_user
#SQL password
MYSQL_PASSWORD=my_password
# example of database URL based on sql
DATABASE_URL= mysql://my_user:my_password@localhost:3306/my_db
# JWT token for veryfying
JWT_TOKEN=secret123

#nodemailer email host
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ITS App <noreply@its.ac.id>"